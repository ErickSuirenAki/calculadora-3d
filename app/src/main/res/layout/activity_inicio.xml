<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calculadora 3D"
            android:textColor="#222222"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Cálculos a partir de modelos 3D"
            android:textColor="#777777"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="180dp"
            android:layout_marginTop="32dp"
            android:alpha="0.45"
            android:contentDescription="Ilustração de modelo 3D"
            android:scaleType="fitCenter"
            android:src="@drawable/cubo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Calculadora de massa de objetos 3d"
            android:textColor="#222222"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Abra um arquivo STL para visualizar o objeto e calcular seu volume, massa e centro de massa."
            android:textColor="#666666"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnComecar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="Começar"
            android:textAllCaps="false"
            android:textSize="16sp"
             />

        <Button
            android:id="@+id/btnRealidadeAumentada"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Realidade Aumentada(teste)"
            android:textAllCaps="false"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
